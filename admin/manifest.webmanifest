{
  "name": "Sankruv Media Client Hub",
  "short_name": "Client Hub",
  "description": "Clients, projects, reminders and payments for the Sankruv Media team.",
  "id": "./",
  "start_url": "app.php",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0e18",
  "theme_color": "#0b0e18",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Clients", "url": "app.php#/clients", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Reminders", "url": "app.php#/reminders", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Projects", "url": "app.php#/projects", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
